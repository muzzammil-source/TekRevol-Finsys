# TekRevol FinSys — environment configuration
# Copy to .env and fill in what you need. .env is gitignored.

# --- Ports -------------------------------------------------------------------
# Vite dev/preview port. In production this is the port Express serves on.
PORT=5000

# Express API port in development.
SERVER_PORT=3001

# Where the Vite dev server proxies /api requests.
API_PROXY_TARGET=http://localhost:3001

# Base path for the built frontend. Change only if hosting under a sub-path.
BASE_PATH=/

# Set to "production" to make Express serve the built SPA from dist/public.
# NODE_ENV=production

# --- Plaid (optional) --------------------------------------------------------
# Without these, the Bank Transactions screen still works using manual bank
# profiles and uploaded statements. Live bank sync is disabled.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production. Defaults to sandbox if unset.
PLAID_ENV=sandbox
# Comma-separated Plaid product names (e.g. transactions,auth). Defaults to
# "transactions" if unset.
PLAID_PRODUCTS=transactions
# Comma-separated ISO country codes (e.g. US,CA). Defaults to "US" if unset.
PLAID_COUNTRY_CODES=US

# --- Database ----------------------------------------------------------------
# Path to the SQLite file. Relative paths resolve against server/.
#
# Local development: use a file of your own, e.g. finance.dev.db. It is
# gitignored, so your local work never touches server/finance.db — which is
# still committed and is what the deployment boots from.
#
# Deployment: point this at a mounted volume, e.g. DB_PATH=/data/finance.db.
# Without one the container's database is rebuilt from git on every deploy
# and anything entered on the live site is lost.
DB_PATH=finance.dev.db

# --- Backups -----------------------------------------------------------------
# The server snapshots its own database on a schedule, through SQLite's
# online backup API. Defaults: every 24h, keeping 14 snapshots, written to a
# "backups" folder beside the database. Nothing to install or schedule.
#
# These live on the same volume as the database, so they cover a bad import
# or a deletion — not the loss of the volume. Download copies periodically
# (Admin → GET /api/backups/:name/download) or point BACKUP_DIR at a second
# mount.
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# Defaults to <database folder>/backups.
BACKUP_DIR=

# --- Email / password reset --------------------------------------------------
# Used only for the "Forgot password?" link. Without SMTP_HOST/USER/PASS the
# app still runs and the reset route logs the link to the server console
# instead of emailing it (fine for local development).
SMTP_HOST=
SMTP_PORT=587
# Leave unset for STARTTLS on 587; set true for implicit TLS on 465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TekRevol FinSys <no-reply@tekrevol.com>

# Absolute base URL used to build the reset link. Set this in production
# (e.g. https://finsys.up.railway.app); locally the request's own origin is
# used when it's blank.
APP_BASE_URL=

# --- Auth (reserved) ---------------------------------------------------------
# Not yet used. Reserved for the authentication work in docs/ROADMAP.md.
SESSION_SECRET=
