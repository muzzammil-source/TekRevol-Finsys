# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Local development database (2026-10-13).
# server/finance.db is still TRACKED on purpose: with no volume attached to
# the deployment, the committed copy is the only database the container
# gets, so it is the production snapshot. Development therefore runs against
# its own file (DB_PATH=finance.dev.db in .env), so day-to-day local work
# never touches that snapshot and "refresh the snapshot from production"
# stays a deliberate, visible act.
*.dev.db
*.dev.db-wal
*.dev.db-shm
# Databases pulled down from the deployment for inspection.
prod-finance.db*
*.b64

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv
.env
node_modules/
dist/
.pnpm-store/
*.log
.DS_Store
.env
.env.local
finance.db-shm
finance.db-wal
server/finance.db.bak-*

# Local env
.env*
!.env.example

# Editor
.vscode/
.idea/
